{
    "name": "cancionero/backend",
    "description": "API del proyecto Cancionero. PHP puro, sin framework.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        }
    }
}
