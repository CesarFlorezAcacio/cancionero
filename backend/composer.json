{
    "name": "cancionero/backend",
    "description": "API del proyecto Cancionero. PHP puro, sin framework.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "google/cloud-firestore": "^2.3",
        "kreait/firebase-php": "^8.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
